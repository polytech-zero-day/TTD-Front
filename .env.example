# 백엔드 API 서버 주소. 미설정 시 client.ts에서 http://localhost:8080으로 fallback.
# 배포 빌드에서는 GitHub Actions repository variable API_BASE_URL 값이 주입된다.
VITE_API_BASE_URL=

# PortOne(포트원) 빌링키 발급용 클라이언트 식별자.
# storeId/channelKey는 결제창을 여는 데 쓰는 공개 식별자로, Stripe의 publishable key와
# 같은 성격이라 VITE_ 접두사로 클라이언트 번들에 포함돼도 안전하다.
# 실제 값은 .env.local(gitignore 대상)에 채워 넣는다.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# 결제 데모 모드(설계서 S-13). 카드 팝업은 항상 뜨고, 처리 방식만 달라진다.
#  - false(권장): F117(미가맹점)일 때만 데모 성공 처리. 사용자 취소·실카드 거절은 실제 실패.
#  - true: 카드 발급 실패·취소 등 어떤 실패든 데모 성공(발표 안정성 최우선).
# 어느 쪽이든 백엔드 PAYMENT_MOCK_ENABLED=true여야 데모 빌링키(demo-*/mock-*)가 승인된다.
VITE_PAYMENT_MOCK=false
